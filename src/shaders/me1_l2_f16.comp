#version 450
// ============================================================================
// MCFI L1 细化（读 L2 粗场放大×2）—— fp16 半精度版
// 与 me1_l2.comp 同逻辑；±sr 细化与半像素子像素的 SAD 用 float16_t 双路累加。
// 需 VK_KHR_shader_float16_int8；不支持时 C++ 回退 me1_l2（fp32）。
// push: uP0=(R,block,dsW,dsH)  uP1=(R2,0,gw2,gh2)  sr
// ============================================================================
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D uPrev;
layout(set = 0, binding = 1) uniform sampler2D uCur;
layout(set = 0, binding = 2) uniform sampler2D uMVPrev;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D uMV;
layout(set = 0, binding = 4) uniform sampler2D uGMV;
layout(set = 0, binding = 5) uniform sampler2D uMvL2;
layout(push_constant) uniform PC { ivec4 uP0; ivec4 uP1; int sr; } pc;

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    int dsW = pc.uP0.z, dsH = pc.uP0.w, block = pc.uP0.y, R = pc.uP0.x;
    int gw  = (dsW + block - 1) / block;
    int gh  = (dsH + block - 1) / block;
    if (g.x >= gw || g.y >= gh) return;
    int R2 = pc.uP1.x, gw2 = pc.uP1.z, gh2 = pc.uP1.w;

    vec2 dsSize = vec2(float(dsW), float(dsH));
    vec2 base = (vec2(g * block) + vec2(0.5 * float(block))) / dsSize;

    vec2 gL2 = vec2(g) / 2.0;
    vec4 l2 = texture(uMvL2, (gL2 + 0.5) / vec2(float(max(gw2,1)), float(max(gh2,1))));
    vec2 centerFromL2 = (l2.xy * 2.0 - 1.0) * float(R2) * 2.0;
    vec2 c1 = texture(uMVPrev, (vec2(g) + 0.5) / vec2(float(gw), float(gh))).xy;
    vec2 centerFromL1 = (c1 * 2.0 - 1.0) * float(R);
    vec2 center = mix(centerFromL1, centerFromL2, step(0.3, l2.z));
    int sr = pc.sr;

    // 零位移参考（fp16 双路）
    float16_t zA = float16_t(0.0), zB = float16_t(0.0);
    for (int by = 0; by < block; by += 2) {
        for (int bx = 0; bx < block; bx += 2) {
            vec2 pp = base + (vec2(float(bx), float(by)) + 0.5 - 0.5 * float(block)) / dsSize;
            vec3 c = texture(uCur, pp).rgb, q = texture(uPrev, pp).rgb;
            float16_t d = float16_t(abs(c.r - q.r)) + float16_t(abs(c.g - q.g)) + float16_t(abs(c.b - q.b));
            float sel = step(1.0, float(bx & 2));
            zA = float16_t(float(zA) + float(d) * (1.0 - sel));
            zB = float16_t(float(zB) + float(d) * sel);
        }
    }
    float zeroSad = float(zA) + float(zB);

    float bestSad = 1e30;
    vec2 bestOff = center;
    for (int dy = -sr; dy <= sr; dy++) {
        for (int dx = -sr; dx <= sr; dx++) {
            vec2 cp = clamp(center + vec2(float(dx), float(dy)), vec2(-float(R)), vec2(float(R)));
            vec2 off = cp / dsSize;
            float16_t sA = float16_t(0.0), sB = float16_t(0.0);
            for (int by = 0; by < block; by += 2) {
                for (int bx = 0; bx < block; bx += 2) {
                    vec2 pp = base + (vec2(float(bx), float(by)) + 0.5 - 0.5 * float(block)) / dsSize;
                    vec3 c = texture(uCur, pp).rgb, q = texture(uPrev, pp - off).rgb;
                    float16_t d = float16_t(abs(c.r - q.r)) + float16_t(abs(c.g - q.g)) + float16_t(abs(c.b - q.b));
                    float sel = step(1.0, float(bx & 2));
                    sA = float16_t(float(sA) + float(d) * (1.0 - sel));
                    sB = float16_t(float(sB) + float(d) * sel);
                }
            }
            float sad = float(sA) + float(sB);
            float better = step(sad, bestSad);
            bestSad = min(bestSad, sad);
            bestOff = mix(bestOff, cp, better);
        }
    }

    // GMV（单次，保持 fp32）
    float sadGmv = 1e30;
    vec4 gmvData = texture(uGMV, vec2(0.5));
    if (gmvData.z > 0.05) {
        vec2 gmvPix = (gmvData.xy * 2.0 - 1.0) * float(R);
        vec2 cp = clamp(gmvPix, vec2(-float(R)), vec2(float(R)));
        vec2 off = cp / dsSize;
        float sad = 0.0;
        for (int by = 0; by < block; by += 2) {
            for (int bx = 0; bx < block; bx += 2) {
                vec2 pp = base + (vec2(float(bx), float(by)) + 0.5 - 0.5 * float(block)) / dsSize;
                vec3 c = texture(uCur, pp).rgb, q = texture(uPrev, pp - off).rgb;
                sad += abs(c.r - q.r) + abs(c.g - q.g) + abs(c.b - q.b);
            }
        }
        sadGmv = sad;
        float better = step(sad, bestSad);
        bestSad = min(bestSad, sad);
        bestOff = mix(bestOff, cp, better);
    }

    // 半像素子像素（fp16 双路）
    vec2 sub[8];
    sub[0] = bestOff + vec2( 0.5,  0.0); sub[1] = bestOff + vec2(-0.5,  0.0);
    sub[2] = bestOff + vec2( 0.0,  0.5); sub[3] = bestOff + vec2( 0.0, -0.5);
    sub[4] = bestOff + vec2( 0.5,  0.5); sub[5] = bestOff + vec2(-0.5,  0.5);
    sub[6] = bestOff + vec2( 0.5, -0.5); sub[7] = bestOff + vec2(-0.5, -0.5);
    for (int i = 0; i < 8; i++) {
        vec2 cp = clamp(sub[i], vec2(-float(R)), vec2(float(R)));
        vec2 off = cp / dsSize;
        float16_t sA = float16_t(0.0), sB = float16_t(0.0);
        for (int by = 0; by < block; by += 2) {
            for (int bx = 0; bx < block; bx += 2) {
                vec2 pp = base + (vec2(float(bx), float(by)) + 0.5 - 0.5 * float(block)) / dsSize;
                vec3 c = texture(uCur, pp).rgb, q = texture(uPrev, pp - off).rgb;
                float16_t d = float16_t(abs(c.r - q.r)) + float16_t(abs(c.g - q.g)) + float16_t(abs(c.b - q.b));
                float sel = step(1.0, float(bx & 2));
                sA = float16_t(float(sA) + float(d) * (1.0 - sel));
                sB = float16_t(float(sB) + float(d) * sel);
            }
        }
        float sad = float(sA) + float(sB);
        float better = step(sad, bestSad);
        bestSad = min(bestSad, sad);
        bestOff = mix(bestOff, cp, better);
    }

    float vx = 0.5, vy = 0.5, conf = 0.25;
    float ok = 1.0 - step(zeroSad * 0.70, bestSad);
    vec2 vn = (bestOff + vec2(float(R))) / (2.0 * vec2(float(R)));
    vx = mix(0.5, vn.x, ok);
    vy = mix(0.5, vn.y, ok);
    conf = mix(0.25, clamp(1.0 - bestSad / (float(block * block) * 0.375), 0.0, 1.0), ok);
    float gm = (1.0 - step(0.35, conf)) * step(0.05, gmvData.z)
             * (1.0 - step(zeroSad * 1.05, sadGmv));
    vec2 gvN = gmvData.xy * 2.0 - 1.0;
    vx = mix(vx, (gvN.x + 1.0) * 0.5, gm);
    vy = mix(vy, (gvN.y + 1.0) * 0.5, gm);
    conf = mix(conf, min(conf + 0.15, 0.5), gm);
    imageStore(uMV, g, vec4(vx, vy, conf, 1.0));
}
