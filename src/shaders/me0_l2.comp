#version 450
// ============================================================================
// MCFI 运动估计 —— L2 层（1/8）粗搜索  [多尺度第一层]
// ----------------------------------------------------------------------------
// 原理：在更粗的 1/8 降采样层做一次 3DRS 粗搜索，得到 L2 粗运动场；
//       放大 ×2 后作为 L1（1/4）细化的初始中心。
// 收益：
//   - L2 场只有 L1 的 1/4 像素，计算量极小；
//   - 粗层搜索半径 R2 覆盖范围对应原图更大位移 → 大位移运动也能收敛；
//   - L1 细化从好起点出发，±sr 只需小范围，整体更准更稳。
// 注意：
//   - 结果只写 uMV（writeonly storage image），绝不与 sampler 读写同图（驱动崩溃点）。
//   - 时间/空间预测来自上一帧 L2 场（uMvPrev），保证跨帧连续。
// push constant: uP0 = (R2, block, dsW2, dsH2)
// ============================================================================
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D uPrev;        // L2 降采样 上一帧(1/8)
layout(set = 0, binding = 1) uniform sampler2D uCur;         // L2 降采样 当前帧(1/8)
layout(set = 0, binding = 2) uniform sampler2D uMvPrev;     // L2 上一帧粗场（时间/空间预测）
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D uMV; // L2 粗场输出
layout(push_constant) uniform PC { ivec4 uP0; } pc;

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    int dsW2 = pc.uP0.z, dsH2 = pc.uP0.w, block = pc.uP0.y, R2 = pc.uP0.x;
    int gw2 = (dsW2 + block - 1) / block;
    int gh2 = (dsH2 + block - 1) / block;
    if (g.x >= gw2 || g.y >= gh2) return;

    vec2 dsSize = vec2(float(dsW2), float(dsH2));
    vec2 base = (vec2(g * block) + vec2(0.5 * float(block))) / dsSize;
    vec2 mvSize = vec2(float(gw2), float(gh2));

    // 时间预测（上一帧同块）+ 空间预测（左/上/右上邻块）
    vec2 tm  = texture(uMvPrev, (vec2(g) + 0.5) / mvSize).xy;
    vec2 spL = texture(uMvPrev, (vec2(max(g.x - 1, 0), g.y) + 0.5) / mvSize).xy;
    vec2 spU = texture(uMvPrev, (vec2(g.x, max(g.y - 1, 0)) + 0.5) / mvSize).xy;
    vec2 spR = texture(uMvPrev, (vec2(min(g.x + 1, gw2 - 1), max(g.y - 1, 0)) + 0.5) / mvSize).xy;

    float jit = 1.0 / (2.0 * float(R2));
    vec2 cand[9];
    cand[0] = vec2(0.5);
    cand[1] = tm;
    cand[2] = spL; cand[3] = spU; cand[4] = spR;
    cand[5] = tm + vec2( jit, 0.0); cand[6] = tm + vec2(-jit, 0.0);
    cand[7] = tm + vec2(0.0,  jit); cand[8] = tm + vec2(0.0, -jit);

    float bestSad = 1e30, zeroSad = 1e30;
    vec2 bestOff = cand[0];
    for (int k = 0; k < 9; k++) {
        vec2 cp = clamp(cand[k], 0.0, 1.0);
        vec2 off = (cp * 2.0 - 1.0) * float(R2) / dsSize;
        float sad = 0.0;
        for (int by = 0; by < block; by += 2) {
            for (int bx = 0; bx < block; bx += 2) {
                vec2 pp = base + (vec2(float(bx), float(by)) + 0.5 - 0.5 * float(block)) / dsSize;
                vec3 c = texture(uCur, pp).rgb;
                vec3 q = texture(uPrev, pp - off).rgb;
                sad += abs(c.r - q.r) + abs(c.g - q.g) + abs(c.b - q.b);
            }
        }
        zeroSad = (k == 0) ? sad : zeroSad;
        float better = step(sad, bestSad);          // 无分支
        bestSad = min(bestSad, sad);
        bestOff = mix(bestOff, cp, better);
    }

    float vx = 0.5, vy = 0.5, conf = 0.25;
    float ok = 1.0 - step(zeroSad * 0.70, bestSad);
    vx = mix(0.5, bestOff.x, ok);
    vy = mix(0.5, bestOff.y, ok);
    conf = mix(0.25, clamp(1.0 - bestSad / (float(block * block) * 0.375), 0.0, 1.0), ok);
    imageStore(uMV, g, vec4(vx, vy, conf, 1.0));
}
