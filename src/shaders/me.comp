#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D uPrev;
layout(set = 0, binding = 1) uniform sampler2D uCur;
layout(set = 0, binding = 2, rgba8) uniform image2D uMV;
layout(push_constant) uniform PC { ivec4 uP0; ivec4 uP1; } pc;
void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    int dsW = pc.uP0.z, dsH = pc.uP0.w, block = pc.uP0.y, R = pc.uP0.x;
    int gw = (dsW + block - 1) / block;
    int gh = (dsH + block - 1) / block;
    if (g.x >= gw || g.y >= gh) return;
    vec2 dsSize = vec2(float(dsW), float(dsH));
    vec2 base = (vec2(g * block) + vec2(0.5 * float(block))) / dsSize;
    int pass = pc.uP1.x;
    vec2 center = vec2(0.0);
    if (pass == 1) {
        vec4 c0 = imageLoad(uMV, g);
        center = (c0.xy * 2.0 - 1.0) * float(R);
    }
    int sr = (pass == 1) ? 2 : R;
    float bestSad = 1e30;
    vec2 bestOff = center;
    for (int dy = -sr; dy <= sr; dy++) {
        for (int dx = -sr; dx <= sr; dx++) {
            vec2 cand = center + vec2(float(dx), float(dy));
            cand = clamp(cand, vec2(-float(R)), vec2(float(R)));
            vec2 off = cand / dsSize;
            float sad = 0.0;
            for (int by = 0; by < block; by++) {
                for (int bx = 0; bx < block; bx++) {
                    vec2 pp = base + (vec2(float(bx), float(by)) + 0.5 - 0.5 * float(block)) / dsSize;
                    vec3 c = texture(uCur, pp).rgb;
                    vec3 q = texture(uPrev, pp - off).rgb;
                    sad += abs(c.r - q.r) + abs(c.g - q.g) + abs(c.b - q.b);
                }
            }
            if (sad < bestSad) { bestSad = sad; bestOff = cand; }
        }
    }
    float vx = (bestOff.x + float(R)) / (2.0 * float(R));
    float vy = (bestOff.y + float(R)) / (2.0 * float(R));
    float conf = clamp(1.0 - bestSad / (float(block * block) * 1.5), 0.0, 1.0);
    imageStore(uMV, g, vec4(vx, vy, conf, 1.0));
}
